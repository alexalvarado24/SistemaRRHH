@model IEnumerable<SistemaRRHH.Controllers.PermisoViewModel>

@{
	ViewBag.Title = "Permisos";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Solicitudes de Permiso</h2>

<div class="row">
	<div class="col-md-8">
		<p>
			@Html.ActionLink("Nueva Solicitud", "Create", null, new { @class = "btn btn-success" })
		</p>
	</div>
	<div class="col-md-4">
		<div class="input-group">
			<input type="text" id="busquedaRapida" class="form-control" placeholder="Buscar por empleado..." />
			<span class="input-group-text"><i class="fas fa-search"></i></span>
		</div>
	</div>
</div>

<!-- Tarjetas de estadísticas -->
<div class="row mb-3" id="estadisticasPermisos">
	<div class="col-md-4">
		<div class="card text-white bg-warning">
			<div class="card-body">
				<h5 class="card-title">Pendientes</h5>
				<p class="card-text display-4" id="pendientesCount">@ViewBag.Pendientes</p>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card text-white bg-success">
			<div class="card-body">
				<h5 class="card-title">Aprobados</h5>
				<p class="card-text display-4" id="aprobadosCount">@ViewBag.Aprobados</p>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card text-white bg-danger">
			<div class="card-body">
				<h5 class="card-title">Rechazados</h5>
				<p class="card-text display-4" id="rechazadosCount">@ViewBag.Rechazados</p>
			</div>
		</div>
	</div>
</div>

<!-- Filtros -->
<div class="card mb-3">
	<div class="card-body">
		<div class="row">
			<div class="col-md-3">
				<label>Empleado</label>
				@Html.DropDownList("empleadoId", (SelectList)ViewBag.EmpleadosList, "Todos", new { @class = "form-control", id = "filtroEmpleado" })
			</div>
			<div class="col-md-2">
				<label>Estado</label>
				<select id="filtroEstado" class="form-control">
					<option value="TODOS" @(ViewBag.EstadoSeleccionado == "TODOS" ? "selected" : "")>Todos</option>
					<option value="PENDIENTE" @(ViewBag.EstadoSeleccionado == "PENDIENTE" ? "selected" : "")>Pendientes</option>
					<option value="APROBADO" @(ViewBag.EstadoSeleccionado == "APROBADO" ? "selected" : "")>Aprobados</option>
					<option value="RECHAZADO" @(ViewBag.EstadoSeleccionado == "RECHAZADO" ? "selected" : "")>Rechazados</option>
				</select>
			</div>
			<div class="col-md-2">
				<label>Desde</label>
				<input type="date" id="filtroDesde" class="form-control" value="@ViewBag.DesdeSeleccionado" />
			</div>
			<div class="col-md-2">
				<label>Hasta</label>
				<input type="date" id="filtroHasta" class="form-control" value="@ViewBag.HastaSeleccionado" />
			</div>
			<div class="col-md-3">
				<label>&nbsp;</label>
				<button id="btnFiltrar" class="btn btn-primary form-control">Aplicar Filtros</button>
			</div>
		</div>
	</div>
</div>

<!-- Tabla de permisos -->
<div id="tablaPermisosContainer">
	<table class="table table-striped table-bordered" id="tablaPermisos">
		<thead>
			<tr>
				<th>ID</th>
				<th>Empleado</th>
				<th>Tipo de Permiso</th>
				<th>Fechas</th>
				<th>Días</th>
				<th>Estado</th>
				<th>Acciones</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var item in Model)
			{
				<tr id="permiso-@item.SolicitudPermisoID">
					<td class="text-center">
						@item.SolicitudPermisoID
					</td>
					<td>
						@item.EmpleadoNombre
					</td>
					<td>
						@item.TipoPermiso
				</td>
				<td>
					@(item.FechaInicio?.ToString("dd/MM/yyyy") ?? "N/A") - @(item.FechaFin?.ToString("dd/MM/yyyy") ?? "N/A")
				</td>
				<td class="text-center">
					@item.DiasSolicitados
				</td>
				<td class="text-center">
					@if (item.Estado == "APROBADO")
					{
						<span class="badge bg-success" id="estado-@item.SolicitudPermisoID">Aprobado</span>
					}
					else if (item.Estado == "RECHAZADO")
					{
						<span class="badge bg-danger" id="estado-@item.SolicitudPermisoID">Rechazado</span>
					}
					else if (item.Estado == "PENDIENTE")
					{
						<span class="badge bg-warning text-dark" id="estado-@item.SolicitudPermisoID">Pendiente</span>
					}
					else
					{
						<span class="badge bg-secondary" id="estado-@item.SolicitudPermisoID">@item.Estado</span>
					}
				</td>
				<td class="text-nowrap">
					@if (item.Estado == "PENDIENTE")
					{
						<button class="btn btn-success btn-sm btn-aprobar" data-id="@item.SolicitudPermisoID" data-empleado="@item.EmpleadoNombre">
							Aprobar
						</button>
						<button class="btn btn-danger btn-sm btn-rechazar" data-id="@item.SolicitudPermisoID">
							Rechazar
						</button>
					}
					<button class="btn btn-info btn-sm btn-historial" data-id="@item.EmpleadoID">
						Historial
					</button>
					@Html.ActionLink("Editar", "Edit", new { id = item.SolicitudPermisoID }, new { @class = "btn btn-primary btn-sm" })
				</td>
			</tr>
		}
		</tbody>
	</table>
</div>

<!-- Modal para historial de permisos -->
<div class="modal fade" id="historialModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-info text-white">
				<h5 class="modal-title">Historial de Permisos</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" id="historialModalBody">
				<div class="text-center">Cargando historial...</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

	<script>
        $(document).ready(function() {
            var timeoutId;

            $('#busquedaRapida').on('input', function() {
                clearTimeout(timeoutId);
                var termino = $(this).val().toLowerCase();

                timeoutId = setTimeout(function() {
                    $('#tablaPermisos tbody tr').each(function() {
                        var empleado = $(this).find('td:eq(1)').text().toLowerCase();
                        if (termino === '' || empleado.indexOf(termino) > -1) {
                            $(this).show();
                        } else {
                            $(this).hide();
                        }
                    });
                }, 300);
            });

            $('.btn-aprobar').click(function() {
                var id = $(this).data('id');
                var empleado = $(this).data('empleado');
                var comentario = prompt('Comentario de aprobación para ' + empleado + ':');

                $.ajax({
                    url: '@Url.Action("AprobarPermiso", "Permisos")',
                    type: 'POST',
                    data: { id: id, comentario: comentario },
                    dataType: 'json',
                    success: function(response) {
                        if (response.success) {
                            var badge = $('#estado-' + id);
                            badge.removeClass('bg-warning').addClass('bg-success');
                            badge.text('Aprobado');
                            $('#permiso-' + id + ' .btn-aprobar, #permiso-' + id + ' .btn-rechazar').remove();

                            $('#pendientesCount').text(response.estadisticas.Pendientes);
                            $('#aprobadosCount').text(response.estadisticas.Aprobados);
                            $('#rechazadosCount').text(response.estadisticas.Rechazados);

                            alert(response.message);
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function() {
                        alert('Error al procesar la solicitud');
                    }
                });
            });

            $('.btn-rechazar').click(function() {
                var id = $(this).data('id');
                var motivo = prompt('Motivo de rechazo:');

                if (motivo) {
                    $.ajax({
                        url: '@Url.Action("RechazarPermiso", "Permisos")',
                        type: 'POST',
                        data: { id: id, motivo: motivo },
                        dataType: 'json',
                        success: function(response) {
                            if (response.success) {
                                var badge = $('#estado-' + id);
                                badge.removeClass('bg-warning').addClass('bg-danger');
                                badge.text('Rechazado');
                                $('#permiso-' + id + ' .btn-aprobar, #permiso-' + id + ' .btn-rechazar').remove();

                                var pendientes = parseInt($('#pendientesCount').text()) - 1;
                                var rechazados = parseInt($('#rechazadosCount').text()) + 1;
                                $('#pendientesCount').text(pendientes);
                                $('#rechazadosCount').text(rechazados);

                                alert(response.message);
                            }
                        }
                    });
                }
            });

            $('.btn-historial').click(function() {
                var empleadoId = $(this).data('id');
                $('#historialModal').modal('show');

                $.ajax({
                    url: '@Url.Action("GetHistorialPermisos", "Permisos")',
                    type: 'GET',
                    data: { empleadoId: empleadoId, year: 0 },
                    dataType: 'json',
                    success: function(data) {
                        if (data.length === 0) {
                            $('#historialModalBody').html('<div class="alert alert-info">No hay permisos registrados para este empleado</div>');
                            return;
                        }

                        var html = '<table class="table table-sm">' +
                            '<thead><tr><th>Tipo</th><th>Fechas</th><th>Días</th><th>Estado</th></tr></thead><tbody>';

                        $.each(data, function(i, p) {
                            var estadoClass = p.Estado === 'APROBADO' ? 'bg-success' : (p.Estado === 'RECHAZADO' ? 'bg-danger' : 'bg-warning');
                            var estadoText = p.Estado === 'PENDIENTE' ? 'text-dark' : '';
                            var fechas = new Date(p.FechaInicio).toLocaleDateString() + ' - ' + new Date(p.FechaFin).toLocaleDateString();

                            html += '<tr>' +
                                '<td>' + p.Tipo + '</td>' +
                                '<td>' + fechas + '</td>' +
                                '<td class="text-center">' + p.Dias + '</td>' +
                                '<td><span class="badge ' + estadoClass + ' ' + estadoText + '">' + (p.Estado === 'APROBADO' ? 'Aprobado' : (p.Estado === 'RECHAZADO' ? 'Rechazado' : 'Pendiente')) + '</span></td>' +
                                '</tr>';
                        });

                        html += '</tbody></table>';
                        $('#historialModalBody').html(html);
                    },
                    error: function() {
                        $('#historialModalBody').html('<div class="alert alert-danger">Error al cargar el historial</div>');
                    }
                });
            });

            $('#btnFiltrar').click(function() {
                var empleadoId = $('#filtroEmpleado').val();
                var estado = $('#filtroEstado').val();
                var desde = $('#filtroDesde').val();
                var hasta = $('#filtroHasta').val();

                window.location.href = '@Url.Action("Index", "Permisos")' +
                    '?empleadoId=' + empleadoId +
                    '&estado=' + estado +
                    '&desde=' + desde +
                    '&hasta=' + hasta;
            });
        });
	</script>
}

<style>
	.display-4 {
		font-size: 2rem;
	}

	.table td {
		vertical-align: middle;
	}
</style>