@{
	ViewBag.Title = "Permisos";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	.display-4 {
		font-size: 2rem;
	}

	.table td {
		vertical-align: middle;
	}

	.card {
		border-radius: 15px;
		border: none;
		box-shadow: 0 0 20px rgba(0,0,0,0.1);
		transition: transform 0.3s;
	}

		.card:hover {
			transform: translateY(-5px);
		}

	.btn {
		margin: 2px;
	}

	.table-hover tbody tr:hover {
		background-color: rgba(0,123,255,0.1);
	}

	.badge {
		font-size: 0.9rem;
		padding: 5px 12px;
	}
</style>

<h2>Solicitudes de Permiso</h2>

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert">
		<i class="fas fa-check-circle"></i> @TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show" role="alert">
		<i class="fas fa-exclamation-circle"></i> @TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<div class="row">
	<div class="col-md-8">
		<p>
			<a href="@Url.Action("Create")" class="btn btn-success">
				<i class="fas fa-plus"></i> Nueva Solicitud
			</a>
			<button id="btnMostrarInactivos" class="btn btn-secondary">
				<i class="fas fa-eye"></i> Mostrar Inactivos
			</button>
		</p>
	</div>
	<div class="col-md-4">
		<div class="input-group">
			<input type="text" id="busquedaRapida" class="form-control" placeholder="Buscar por empleado..." />
			<span class="input-group-text bg-success text-white">
				<i class="fas fa-search"></i>
			</span>
		</div>
	</div>
</div>

<!-- Tarjetas de estadisticas -->
<div class="row mb-3" id="estadisticasPermisos">
	<div class="col-md-4">
		<div class="card text-white bg-warning">
			<div class="card-body">
				<h5 class="card-title">
					<i class="fas fa-clock"></i> Pendientes
				</h5>
				<p class="card-text display-4" id="pendientesCount">0</p>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card text-white bg-success">
			<div class="card-body">
				<h5 class="card-title">
					<i class="fas fa-check-circle"></i> Aprobados
				</h5>
				<p class="card-text display-4" id="aprobadosCount">0</p>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card text-white bg-danger">
			<div class="card-body">
				<h5 class="card-title">
					<i class="fas fa-times-circle"></i> Rechazados
				</h5>
				<p class="card-text display-4" id="rechazadosCount">0</p>
			</div>
		</div>
	</div>
</div>

<!-- Filtros -->
<div class="card mb-3">
	<div class="card-body">
		<div class="row">
			<div class="col-md-3">
				<label><i class="fas fa-user"></i> Empleado</label>
				<select id="filtroEmpleado" class="form-control">
					<option value="">Todos</option>
				</select>
			</div>
			<div class="col-md-2">
				<label><i class="fas fa-filter"></i> Estado</label>
				<select id="filtroEstado" class="form-control">
					<option value="TODOS">Todos</option>
					<option value="PENDIENTE">Pendientes</option>
					<option value="APROBADO">Aprobados</option>
					<option value="RECHAZADO">Rechazados</option>
				</select>
			</div>
			<div class="col-md-2">
				<label><i class="fas fa-calendar-alt"></i> Desde</label>
				<input type="date" id="filtroDesde" class="form-control" />
			</div>
			<div class="col-md-2">
				<label><i class="fas fa-calendar-alt"></i> Hasta</label>
				<input type="date" id="filtroHasta" class="form-control" />
			</div>
			<div class="col-md-3">
				<label>&nbsp;</label>
				<button id="btnFiltrar" class="btn btn-primary form-control">
					<i class="fas fa-search"></i> Aplicar Filtros
				</button>
			</div>
		</div>
	</div>
</div>

<!-- Tabla de permisos -->
<div id="tablaPermisosContainer">
	<div class="text-center p-5" id="loadingIndicator">
		<div class="spinner-border text-primary" role="status">
			<span class="visually-hidden">Cargando...</span>
		</div>
		<p>Cargando permisos...</p>
	</div>
	<div id="tablaContent" style="display: none;"></div>
</div>

<!-- Modal para historial de permisos -->
<div class="modal fade" id="historialModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-info text-white">
				<h5 class="modal-title">
					<i class="fas fa-history"></i> Historial de Permisos
				</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" id="historialModalBody">
				<div class="text-center">
					<i class="fas fa-spinner fa-spin fa-2x"></i> Cargando historial...
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<script>
        // Funcion para convertir fecha JSON a formato legible
        function formatearFecha(fechaJson) {
            if (!fechaJson) return 'N/A';
            if (fechaJson === null) return 'N/A';
            if (typeof fechaJson === 'string' && fechaJson.includes('-')) {
                var partes = fechaJson.split('T')[0].split('-');
                if (partes.length === 3) {
                    return partes[2] + '-' + partes[1] + '-' + partes[0];
                }
                return fechaJson.split('T')[0];
            }
            var timestamp = parseInt(fechaJson.toString().replace(/\/Date\((-?\d+)\)\//, '$1'));
            if (isNaN(timestamp)) return 'N/A';
            var fecha = new Date(timestamp);
            var anio = fecha.getFullYear();
            var mes = ('0' + (fecha.getMonth() + 1)).slice(-2);
            var dia = ('0' + fecha.getDate()).slice(-2);
            return dia + '-' + mes + '-' + anio;
        }

        let currentFilters = {
            estado: 'TODOS',
            empleadoId: '',
            desde: '',
            hasta: '',
            mostrarInactivos: false
        };

        $(document).ready(function() {
            cargarEmpleados();
            cargarPermisos();

            $('#btnFiltrar').click(function() {
                currentFilters.estado = $('#filtroEstado').val();
                currentFilters.empleadoId = $('#filtroEmpleado').val();
                currentFilters.desde = $('#filtroDesde').val();
                currentFilters.hasta = $('#filtroHasta').val();
                cargarPermisos();
            });

            $('#busquedaRapida').on('input', function() {
                filtrarTablaLocal($(this).val().toLowerCase());
            });

            $('#btnMostrarInactivos').click(function() {
                currentFilters.mostrarInactivos = !currentFilters.mostrarInactivos;
                $(this).text(currentFilters.mostrarInactivos ? 'Mostrar Activos' : 'Mostrar Inactivos');
                $(this).toggleClass('btn-secondary btn-warning');
                // Resetear busqueda al cambiar vista
                $('#busquedaRapida').val('');
                cargarPermisos();
            });
        });

        function cargarEmpleados() {
            $.ajax({
                url: '@Url.Action("GetEmpleados", "Permisos")',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    var options = '<option value="">Todos</option>';
                    $.each(data, function(i, emp) {
                        options += `<option value="${emp.EmpleadoID}">${emp.Nombre}</option>`;
                    });
                    $('#filtroEmpleado').html(options);
                }
            });
        }

        function cargarPermisos() {
            $('#loadingIndicator').show();
            $('#tablaContent').hide();

            $.ajax({
                url: '@Url.Action("GetAll", "Permisos")',
                type: 'GET',
                data: {
                    estado: currentFilters.estado,
                    empleadoId: currentFilters.empleadoId,
                    desde: currentFilters.desde,
                    hasta: currentFilters.hasta,
                    mostrarInactivos: currentFilters.mostrarInactivos
                },
                dataType: 'json',
                success: function(response) {
                    actualizarEstadisticas(response.estadisticas);
                    renderizarTabla(response.data);
                    $('#loadingIndicator').hide();
                    $('#tablaContent').show();
                },
                error: function() {
                    $('#tablaPermisosContainer').html('<div class="alert alert-danger">Error al cargar los permisos</div>');
                }
            });
        }

        function renderizarTabla(permisos) {
            if (!permisos || permisos.length === 0) {
                var mensaje = currentFilters.mostrarInactivos
                    ? 'No hay permisos inactivos registrados.'
                    : 'No hay solicitudes de permiso registradas.';
                $('#tablaContent').html(`
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle"></i> ${mensaje}
                        <a href="@Url.Action("Create")" class="alert-link">Crear la primera solicitud</a>
                    </div>
                `);
                return;
            }

            var html = `
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="tablaPermisos">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Empleado</th>
                                <th>Tipo de Permiso</th>
                                <th>Fechas</th>
                                <th>Dias</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </thead>
                            <tbody>
            `;

            $.each(permisos, function(i, p) {
                var fechaInicio = formatearFecha(p.FechaInicio);
                var fechaFin = formatearFecha(p.FechaFin);
                var fechas = fechaInicio + ' - ' + fechaFin;

                var estadoClass = '';
                var estadoText = '';
                var estadoIcon = '';

                if (!p.Activo) {
                    estadoClass = 'bg-secondary';
                    estadoText = 'Inactivo';
                    estadoIcon = 'fa-ban';
                } else if (p.Estado === 'APROBADO') {
                    estadoClass = 'bg-success';
                    estadoText = 'Aprobado';
                    estadoIcon = 'fa-check-circle';
                } else if (p.Estado === 'RECHAZADO') {
                    estadoClass = 'bg-danger';
                    estadoText = 'Rechazado';
                    estadoIcon = 'fa-times-circle';
                } else {
                    estadoClass = 'bg-warning text-dark';
                    estadoText = 'Pendiente';
                    estadoIcon = 'fa-clock';
                }

                var acciones = `
                    <button class="btn btn-info btn-sm btn-historial" data-id="${p.EmpleadoID}" title="Ver historial">
                        <i class="fas fa-history"></i> Historial
                    </button>
                `;

                if (p.Activo && p.Estado === 'PENDIENTE') {
                    acciones += `
                        <button class="btn btn-success btn-sm btn-aprobar" data-id="${p.SolicitudPermisoID}" data-empleado="${p.EmpleadoNombre}" title="Aprobar permiso">
                            <i class="fas fa-check"></i> Aprobar
                        </button>
                        <button class="btn btn-danger btn-sm btn-rechazar" data-id="${p.SolicitudPermisoID}" title="Rechazar permiso">
                            <i class="fas fa-times"></i> Rechazar
                        </button>
                        <a href="@Url.Action("Edit")/${p.SolicitudPermisoID}" class="btn btn-warning btn-sm" title="Editar permiso">
                            <i class="fas fa-edit"></i> Editar
                        </a>
                    `;
                }

                // Boton de activar/desactivar
                if (p.Activo) {
                    acciones += `<button class="btn btn-danger btn-sm btn-toggle" data-id="${p.SolicitudPermisoID}" data-nombre="${p.EmpleadoNombre}" data-activo="true" title="Desactivar permiso">
                                    <i class="fas fa-trash"></i> Desactivar
                                </button>`;
                } else {
                    acciones += `<button class="btn btn-success btn-sm btn-toggle" data-id="${p.SolicitudPermisoID}" data-nombre="${p.EmpleadoNombre}" data-activo="false" title="Activar permiso">
                                    <i class="fas fa-undo-alt"></i> Activar
                                </button>`;
                }

                html += `
                    <tr id="permiso-${p.SolicitudPermisoID}" class="${!p.Activo ? 'table-secondary' : ''}">
                        <td class="text-center">${p.SolicitudPermisoID}</td>
                        <td><strong>${p.EmpleadoNombre}</strong></td>
                        <td>${p.TipoPermiso}</td>
                        <td>${fechas}</td>
                        <td class="text-center"><span class="badge bg-secondary">${p.DiasSolicitados}</span></td>
                        <td class="text-center">
                            <span class="badge ${estadoClass}" id="estado-${p.SolicitudPermisoID}">
                                <i class="fas ${estadoIcon}"></i> ${estadoText}
                            </span>
                        </td>
                        <td class="text-nowrap">${acciones}</td>
                    </tr>
                `;
            });

           
            $('#tablaContent').html(html);

            // Bind events
            $('.btn-aprobar').click(function() { aprobarPermiso($(this).data('id'), $(this).data('empleado')); });
            $('.btn-rechazar').click(function() { rechazarPermiso($(this).data('id')); });
            $('.btn-historial').click(function() { verHistorial($(this).data('id')); });
            $('.btn-toggle').click(function() {
                togglePermiso($(this).data('id'), $(this).data('nombre'), $(this).data('activo'));
            });
        }

        function togglePermiso(id, nombre, esActivo) {
            var titulo = esActivo === true ? 'Desactivar permiso?' : 'Activar permiso?';
            var texto = esActivo === true
                ? `El permiso de "${nombre}" sera desactivado.`
                : `El permiso de "${nombre}" sera activado nuevamente.`;
            var icono = esActivo === true ? 'warning' : 'question';
            var botonColor = esActivo === true ? '#d33' : '#28a745';
            var botonTexto = esActivo === true ? 'Si, desactivar' : 'Si, activar';

            Swal.fire({
                title: titulo,
                text: texto,
                icon: icono,
                showCancelButton: true,
                confirmButtonColor: botonColor,
                cancelButtonColor: '#3085d6',
                confirmButtonText: botonTexto,
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("ToggleActivo", "Permisos")',
                        type: 'POST',
                        data: JSON.stringify({ id: id }),
                        contentType: 'application/json',
                        dataType: 'json',
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    title: esActivo === true ? 'Desactivado!' : 'Activado!',
                                    text: response.message,
                                    icon: 'success',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                cargarPermisos();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Ocurrio un error al procesar la solicitud', 'error');
                        }
                    });
                }
            });
        }

        function aprobarPermiso(id, empleado) {
            Swal.fire({
                title: 'Aprobar Permiso',
                text: `Ingrese un comentario para ${empleado}:`,
                input: 'textarea',
                inputPlaceholder: 'Comentario de aprobacion...',
                showCancelButton: true,
                confirmButtonColor: '#28a745',
                confirmButtonText: 'Aprobar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed && result.value !== null) {
                    $.ajax({
                        url: '@Url.Action("Aprobar", "Permisos")',
                        type: 'POST',
                        data: JSON.stringify({ id: id, comentario: result.value }),
                        contentType: 'application/json',
                        dataType: 'json',
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('Aprobado', response.message, 'success');
                                cargarPermisos();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Error al aprobar el permiso', 'error');
                        }
                    });
                }
            });
        }

        function rechazarPermiso(id) {
            Swal.fire({
                title: 'Rechazar Permiso',
                text: 'Ingrese el motivo del rechazo:',
                input: 'textarea',
                inputPlaceholder: 'Motivo del rechazo...',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                confirmButtonText: 'Rechazar',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed && result.value !== null) {
                    $.ajax({
                        url: '@Url.Action("Rechazar", "Permisos")',
                        type: 'POST',
                        data: JSON.stringify({ id: id, motivo: result.value }),
                        contentType: 'application/json',
                        dataType: 'json',
                        success: function(response) {
                            if (response.success) {
                                Swal.fire('Rechazado', response.message, 'success');
                                cargarPermisos();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Error al rechazar el permiso', 'error');
                        }
                    });
                }
            });
        }

        function verHistorial(empleadoId) {
            $('#historialModal').modal('show');
            $('#historialModalBody').html('<div class="text-center"><i class="fas fa-spinner fa-spin fa-2x"></i> Cargando historial...</div>');

            $.ajax({
                url: '@Url.Action("GetHistorial", "Permisos")',
                type: 'GET',
                data: { empleadoId: empleadoId, year: 0 },
                dataType: 'json',
                success: function(data) {
                    if (data.length === 0) {
                        $('#historialModalBody').html('<div class="alert alert-info">No hay permisos registrados para este empleado</div>');
                        return;
                    }

                    var html = `
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead class="table-dark">
                                    <tr>
                                        <th><i class="fas fa-tag"></i> Tipo</th>
                                        <th><i class="fas fa-calendar-alt"></i> Fechas</th>
                                        <th><i class="fas fa-sun"></i> Dias</th>
                                        <th><i class="fas fa-chart-line"></i> Estado</th>
                                    </thead>
                                    <tbody>
                    `;

                    $.each(data, function(i, p) {
                        var fechaInicio = formatearFecha(p.FechaInicio);
                        var fechaFin = formatearFecha(p.FechaFin);
                        var fechas = fechaInicio + ' - ' + fechaFin;
                        var estadoClass = p.Estado === 'APROBADO' ? 'bg-success' : (p.Estado === 'RECHAZADO' ? 'bg-danger' : 'bg-warning');
                        var estadoIcon = p.Estado === 'APROBADO' ? 'fa-check-circle' : (p.Estado === 'RECHAZADO' ? 'fa-times-circle' : 'fa-clock');

                        html += `
                            <tr>
                                <td>${p.Tipo}</td>
                                <td>${fechas}</td>
                                <td class="text-center"><span class="badge bg-secondary">${p.Dias}</span></td>
                                <td><span class="badge ${estadoClass}"><i class="fas ${estadoIcon}"></i> ${p.Estado}</span></td>
                            </tr>
                        `;
                    });

                    html += '</tbody></table></div>';
                    $('#historialModalBody').html(html);
                },
                error: function() {
                    $('#historialModalBody').html('<div class="alert alert-danger">Error al cargar el historial</div>');
                }
            });
        }

        function actualizarEstadisticas(estadisticas) {
            $('#pendientesCount').text(estadisticas.Pendientes || 0);
            $('#aprobadosCount').text(estadisticas.Aprobados || 0);
            $('#rechazadosCount').text(estadisticas.Rechazados || 0);
        }

        function filtrarTablaLocal(termino) {
            if ($('#tablaPermisos').length) {
                $('#tablaPermisos tbody tr').each(function() {
                    var empleado = $(this).find('td:eq(1)').text().toLowerCase();
                    $(this).toggle(termino === '' || empleado.indexOf(termino) > -1);
                });
            }
        }
	</script>
}