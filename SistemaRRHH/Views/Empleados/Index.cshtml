@{
	ViewBag.Title = "Empleados";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	.display-4 {
		font-size: 2rem;
	}

	.table td {
		vertical-align: middle;
	}

	.card {
		border-radius: 15px;
		border: none;
		box-shadow: 0 0 20px rgba(0,0,0,0.1);
		transition: transform 0.3s;
	}

		.card:hover {
			transform: translateY(-5px);
		}

	.btn {
		margin: 2px;
	}

	.table-hover tbody tr:hover {
		background-color: rgba(0,123,255,0.1);
	}
</style>

<h2>Gestion de Empleados</h2>

@if (TempData["Success"] != null)
{
	<div class="alert alert-success alert-dismissible fade show" role="alert">
		<i class="fas fa-check-circle"></i> @TempData["Success"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

@if (TempData["Error"] != null)
{
	<div class="alert alert-danger alert-dismissible fade show" role="alert">
		<i class="fas fa-exclamation-circle"></i> @TempData["Error"]
		<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
	</div>
}

<div class="row">
	<div class="col-md-6">
		<p>
			<a href="@Url.Action("Create")" class="btn btn-primary">
				<i class="fas fa-plus"></i> Crear Nuevo Empleado
			</a>
			<button id="btnMostrarInactivos" class="btn btn-secondary">
				<i class="fas fa-eye"></i> Mostrar Inactivos
			</button>
			<a href="@Url.Action("Empleados", "Reporte")" class="btn btn-danger" id="btnReporte">
				<i class="fas fa-file-pdf"></i> Reporte
			</a>
		</p>
	</div>
	<div class="col-md-6">
		<div class="input-group">
			<input type="text" id="busquedaRapida" class="form-control" placeholder="Buscar por nombre, email o telefono..." />
			<span class="input-group-text bg-primary text-white">
				<i class="fas fa-search"></i>
			</span>
		</div>
	</div>
</div>

<!-- Tarjetas de estadisticas -->
<div class="row mb-3" id="estadisticasEmpleados">
	<div class="col-md-4">
		<div class="card text-white bg-primary">
			<div class="card-body">
				<h5 class="card-title">
					<i class="fas fa-users"></i> Total Empleados
				</h5>
				<p class="card-text display-4" id="totalEmpleados">0</p>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card text-white bg-success">
			<div class="card-body">
				<h5 class="card-title">
					<i class="fas fa-user-check"></i> Empleados Activos
				</h5>
				<p class="card-text display-4" id="totalActivos">0</p>
			</div>
		</div>
	</div>
	<div class="col-md-4">
		<div class="card text-white bg-info">
			<div class="card-body">
				<h5 class="card-title">
					<i class="fas fa-dollar-sign"></i> Salario Promedio
				</h5>
				<p class="card-text display-4" id="salarioPromedio">$0</p>
			</div>
		</div>
	</div>
</div>

<!-- Filtros -->
<div class="card mb-3">
	<div class="card-body">
		<div class="row">
			<div class="col-md-4">
				<label><i class="fas fa-briefcase"></i> Filtrar por Cargo</label>
				<select id="cargoFiltro" class="form-control">
					<option value="">Todos los cargos</option>
				</select>
			</div>
			<div class="col-md-4">
				<label>&nbsp;</label>
				<button id="btnFiltrar" class="btn btn-primary form-control">
					<i class="fas fa-search"></i> Aplicar Filtros
				</button>
			</div>
			<div class="col-md-4">
				<label>&nbsp;</label>
				<button id="btnEstadisticas" class="btn btn-outline-dark form-control">
					<i class="fas fa-chart-bar"></i> Estadisticas por Depto
				</button>
			</div>
		</div>
	</div>
</div>

<!-- Tabla de empleados -->
<div id="tablaEmpleadosContainer">
	<div class="text-center p-5" id="loadingIndicator">
		<div class="spinner-border text-primary" role="status">
			<span class="visually-hidden">Cargando...</span>
		</div>
		<p>Cargando empleados...</p>
	</div>
	<div id="tablaContent" style="display: none;"></div>
</div>

<!-- Modal para mostrar detalles via AJAX -->
<div class="modal fade" id="detalleModal" tabindex="-1">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header bg-info text-white">
				<h5 class="modal-title">
					<i class="fas fa-user-circle"></i> Detalles del Empleado
				</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" id="detalleModalBody">
				<div class="text-center">
					<i class="fas fa-spinner fa-spin fa-2x"></i> Cargando...
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
			</div>
		</div>
	</div>
</div>

<!-- Modal para estadisticas -->
<div class="modal fade" id="estadisticasModal" tabindex="-1">
	<div class="modal-dialog modal-lg">
		<div class="modal-content">
			<div class="modal-header bg-dark text-white">
				<h5 class="modal-title">
					<i class="fas fa-chart-bar"></i> Estadisticas por Departamento
				</h5>
				<button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body" id="estadisticasModalBody">
				<div class="text-center">
					<i class="fas fa-spinner fa-spin fa-2x"></i> Cargando estadisticas...
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<script>
        let currentFilters = {
            busqueda: '',
            cargoId: '',
            mostrarInactivos: false        };

        $(document).ready(function() {
            cargarCargos();
            cargarEmpleados();

            $('#btnFiltrar').click(function() {
                currentFilters = {
                    busqueda: $('#busquedaRapida').val(),
                    cargoId: $('#cargoFiltro').val(),
                    mostrarInactivos: currentFilters.mostrarInactivos
                };
                cargarEmpleados();
            });

            $('#busquedaRapida').on('input', function() {
                currentFilters.busqueda = $(this).val();
                cargarEmpleados();
            });

            $('#btnEstadisticas').click(function() {
                cargarEstadisticas();
            });

            $('#btnMostrarInactivos').click(function() {
                currentFilters.mostrarInactivos = !currentFilters.mostrarInactivos;
                $(this).text(currentFilters.mostrarInactivos ? 'Mostrar Activos' : 'Mostrar Inactivos');
                $(this).toggleClass('btn-secondary btn-warning');
                $('#busquedaRapida').val('');
                currentFilters.busqueda = '';
                cargarEmpleados();
            });

            $('#btnReporte').click(function(e) {
                e.preventDefault();
                window.open('@Url.Action("Empleados", "Reporte")', '_blank');
            });
        });

        function cargarCargos() {
            $.ajax({
                url: '@Url.Action("GetCargos", "Empleados")',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    var options = '<option value="">Todos los cargos</option>';
                    $.each(data, function(i, c) {
                        options += `<option value="${c.CargoID}">${c.NombreCargo}</option>`;
                    });
                    $('#cargoFiltro').html(options);
                },
                error: function() {
                    console.log('Error al cargar cargos');
                }
            });
        }

        function cargarEmpleados() {
            $('#loadingIndicator').show();
            $('#tablaContent').hide();

            $.ajax({
                url: '@Url.Action("GetAll", "Empleados")',
                type: 'GET',
                data: {
                    busqueda: currentFilters.busqueda,
                    cargoId: currentFilters.cargoId,
                    mostrarInactivos: currentFilters.mostrarInactivos
                },
                dataType: 'json',
                success: function(response) {
                    actualizarEstadisticas(response.estadisticas);
                    renderizarTabla(response.data);
                    $('#loadingIndicator').hide();
                    $('#tablaContent').show();
                },
                error: function() {
                    $('#tablaEmpleadosContainer').html('<div class="alert alert-danger">Error al cargar los empleados</div>');
                    $('#loadingIndicator').hide();
                }
            });
        }

        function renderizarTabla(empleados) {
            if (!empleados || empleados.length === 0) {
                var mensaje = currentFilters.mostrarInactivos
                    ? 'No hay empleados inactivos registrados.'
                    : 'No hay empleados registrados.';
                $('#tablaContent').html(`
                    <div class="alert alert-info text-center">
                        <i class="fas fa-info-circle"></i> ${mensaje}
                        <a href="@Url.Action("Create")" class="alert-link">Crear el primer empleado</a>
                    </div>
                `);
                return;
            }

            var html = `
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover" id="tablaEmpleados">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre Completo</th>
                                <th>Telefono</th>
                                <th>Email</th>
                                <th>Cargo</th>
                                <th>Salario</th>
                                <th>Horario</th>
                                <th>Acciones</th>
                            </thead>
                            <tbody>
            `;

            $.each(empleados, function(i, e) {
                var botonToggle = e.Estado === 'Activo'
                    ? `<button class="btn btn-danger btn-sm btn-toggle" data-id="${e.EmpleadoID}" data-nombre="${e.NombreCompleto}" data-estado="Activo">
                           <i class="fas fa-trash"></i> Desactivar
                       </button>`
                    : `<button class="btn btn-success btn-sm btn-toggle" data-id="${e.EmpleadoID}" data-nombre="${e.NombreCompleto}" data-estado="Inactivo">
                           <i class="fas fa-undo-alt"></i> Activar
                       </button>`;

                var horarioHtml = `<strong>${e.NombreHorario || 'Sin Horario'}</strong>`;
                if (e.HoraEntrada) {
                    var horaEntrada = e.HoraEntrada.length > 5 ? e.HoraEntrada.substring(0, 5) : e.HoraEntrada;
                    var horaSalida = e.HoraSalida.length > 5 ? e.HoraSalida.substring(0, 5) : e.HoraSalida;
                    horarioHtml += `<br/><small class="text-muted">${horaEntrada} - ${horaSalida}</small>`;
                }

                html += `
                    <tr id="empleado-${e.EmpleadoID}">
                        <td class="text-center">${e.EmpleadoID}</td>
                        <td><strong>${e.NombreCompleto}</strong></td>
                        <td>${e.Telefono || '-'}</td>
                        <td>${e.Email || '-'}</td>
                        <td>${e.NombreCargo}</td>
                        <td class="text-end">${e.SalarioActual ? '$' + parseFloat(e.SalarioActual).toLocaleString('es-SV', { minimumFractionDigits: 2 }) : '-'}</td>
                        <td>${horarioHtml}</td>
                        <td class="text-nowrap">
                            <button class="btn btn-info btn-sm btn-detalle" data-id="${e.EmpleadoID}" data-empleado="${e.NombreCompleto}">
                                <i class="fas fa-eye"></i> Detalle
                            </button>
                            <a href="@Url.Action("Edit")/${e.EmpleadoID}" class="btn btn-warning btn-sm">
                                <i class="fas fa-edit"></i> Editar
                            </a>
                            ${botonToggle}
                        </td>
                    </tr>
                `;
            });

            $('#tablaContent').html(html);

            $('.btn-detalle').click(function() {
                cargarDetalleAjax($(this).data('id'), $(this).data('empleado'));
            });

            $('.btn-toggle').click(function() {
                toggleEmpleado($(this).data('id'), $(this).data('nombre'), $(this).data('estado'));
            });
        }

        function toggleEmpleado(id, nombre, estadoActual) {
            var esActivo = estadoActual === 'Activo';
            var titulo = esActivo ? '¿Desactivar empleado?' : '¿Activar empleado?';
            var texto = esActivo
                ? `El empleado "${nombre}" sera desactivado. Podra activarlo nuevamente mas tarde.`
                : `El empleado "${nombre}" sera activado nuevamente.`;
            var icono = esActivo ? 'warning' : 'question';
            var botonColor = esActivo ? '#d33' : '#28a745';
            var botonTexto = esActivo ? 'Si, desactivar' : 'Si, activar';

            Swal.fire({
                title: titulo,
                text: texto,
                icon: icono,
                showCancelButton: true,
                confirmButtonColor: botonColor,
                cancelButtonColor: '#3085d6',
                confirmButtonText: botonTexto,
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("ToggleActivo", "Empleados")',
                        type: 'POST',
                        data: JSON.stringify({ id: id }),
                        contentType: 'application/json',
                        dataType: 'json',
                        success: function(response) {
                            if (response.success) {
                                Swal.fire({
                                    title: esActivo ? '¡Desactivado!' : '¡Activado!',
                                    text: response.message,
                                    icon: 'success',
                                    timer: 2000,
                                    showConfirmButton: false
                                });
                                cargarEmpleados();
                            } else {
                                Swal.fire('Error', response.message, 'error');
                            }
                        },
                        error: function() {
                            Swal.fire('Error', 'Ocurrio un error al procesar la solicitud', 'error');
                        }
                    });
                }
            });
        }

        function cargarDetalleAjax(id, nombre) {
            $('#detalleModal').modal('show');
            $('#detalleModalBody').html('<div class="text-center"><i class="fas fa-spinner fa-spin fa-2x"></i> Cargando...</div>');

            $.ajax({
                url: '@Url.Action("GetDetalleEmpleado", "Empleados")',
                type: 'GET',
                data: { id: id },
                dataType: 'json',
                success: function(response) {
                    if (response.success) {
                        var e = response.data;
                        var html = `
                            <div class="card">
                                <div class="card-header bg-light">
                                    <strong><i class="fas fa-user"></i> ${e.NombreCompleto}</strong>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-12 mb-2">
                                            <strong>Email:</strong> ${e.Email || 'N/A'}
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <strong>Telefono:</strong> ${e.Telefono || 'N/A'}
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <strong>Direccion:</strong> ${e.Direccion || 'N/A'}
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <strong>Cargo:</strong> ${e.Cargo || 'N/A'}
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <strong>Fecha Ingreso:</strong> ${e.FechaIngreso || 'N/A'}
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <strong>Salario:</strong> ${e.SalarioActual ? '$' + parseFloat(e.SalarioActual).toLocaleString('es-SV', { minimumFractionDigits: 2 }) : '-'}
                                        </div>
                                        <div class="col-md-6 mb-2">
                                            <strong>Edad:</strong> ${e.Edad || 0} años
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <strong>Observaciones:</strong> ${e.Observaciones || 'N/A'}
                                        </div>
                                        <div class="col-md-12 mb-2">
                                            <strong>Estado:</strong>
                                            <span class="${e.Estado === 'Activo' ? 'text-success' : 'text-danger'}">
                                                ${e.Estado || 'N/A'}
                                            </span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        `;
                        $('#detalleModalBody').html(html);
                    } else {
                        $('#detalleModalBody').html('<div class="alert alert-danger">' + response.message + '</div>');
                    }
                },
                error: function() {
                    $('#detalleModalBody').html('<div class="alert alert-danger">Error al cargar detalles</div>');
                }
            });
        }

        function cargarEstadisticas() {
            $('#estadisticasModal').modal('show');
            $('#estadisticasModalBody').html('<div class="text-center"><i class="fas fa-spinner fa-spin fa-2x"></i> Cargando estadisticas...</div>');

            $.ajax({
                url: '@Url.Action("GetEstadisticasPorDepartamento", "Empleados")',
                type: 'GET',
                dataType: 'json',
                success: function(data) {
                    if (data.length === 0) {
                        $('#estadisticasModalBody').html('<div class="alert alert-warning">No hay datos disponibles</div>');
                        return;
                    }

                    var html = `
                        <table class="table table-bordered table-hover">
                            <thead class="table-dark">
                                <tr><th>Departamento</th><th>Cantidad</th><th>Salario Promedio</th><th>Antiguedad Promedio</th></tr>
                            </thead>
                            <tbody>
                    `;

                    $.each(data, function(i, depto) {
                        html += `
                            <tr>
                                <td>${depto.Departamento}</td>
                                <td class="text-center">${depto.Cantidad}</td>
                                <td class="text-end">$${depto.SalarioPromedio.toLocaleString('es-SV', { minimumFractionDigits: 2 })}</td>
                                <td class="text-center">${Math.round(depto.AntiguedadPromedio)} años</td>
                            </tr>
                        `;
                    });

                    html += '</tbody><td>';
                    $('#estadisticasModalBody').html(html);
                },
                error: function() {
                    $('#estadisticasModalBody').html('<div class="alert alert-danger">Error al cargar estadisticas</div>');
                }
            });
        }

        function actualizarEstadisticas(estadisticas) {
            $('#totalEmpleados').text(estadisticas.Total);
            $('#totalActivos').text(estadisticas.Activos);
            $('#salarioPromedio').text('$' + estadisticas.SalarioPromedio.toLocaleString('es-SV', { minimumFractionDigits: 0 }));
        }
	</script>
}