@model IEnumerable<SistemaRRHH.Models.Departamentos>

@{
    ViewBag.Title = "Departamentos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .display-4 {
        font-size: 2rem;
    }

    .table td {
        vertical-align: middle;
    }

    .card {
        border-radius: 15px;
        border: none;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
        transition: transform 0.3s;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .table-hover tbody tr:hover {
        background-color: rgba(0,123,255,0.1);
    }
</style>

<h2>Gestion de Departamentos</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <p>
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Crear Nuevo Departamento
            </a>
            <button id="btnMostrarInactivos" class="btn btn-secondary">
                <i class="fas fa-eye"></i> Mostrar Inactivos
            </button>
        </p>
    </div>
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" id="busquedaRapida" class="form-control" placeholder="Buscar por nombre de departamento..." />
            <span class="input-group-text bg-primary text-white">
                <i class="fas fa-search"></i>
            </span>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-building"></i> Total Departamentos</h5>
                <p class="card-text display-4" id="totalDepartamentos">0</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-toggle-on"></i> Departamentos Activos</h5>
                <p class="card-text display-4" id="totalActivos">0</p>
            </div>
        </div>
    </div>
</div>

<div id="tablaContainer">
    <div class="text-center p-5" id="loadingIndicator">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando departamentos...</p>
    </div>
    <div id="tablaContent" style="display: none;"></div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let filters = { busqueda: '', mostrarInactivos: false };

        $(document).ready(function () {
            cargarDepartamentos();

            $('#busquedaRapida').on('input', function () {
                filters.busqueda = $(this).val();
                cargarDepartamentos();
            });

            $('#btnMostrarInactivos').click(function () {
                filters.mostrarInactivos = !filters.mostrarInactivos;
                $(this).text(filters.mostrarInactivos ? 'Mostrar Activos' : 'Mostrar Inactivos');
                $(this).toggleClass('btn-secondary btn-warning');
                cargarDepartamentos();
            });
        });

        function cargarDepartamentos() {
            $('#loadingIndicator').show();
            $('#tablaContent').hide();

            $.ajax({
                url: '@Url.Action("GetAll", "Departamentos")',
                type: 'GET',
                data: filters,
                dataType: 'json',
                success: function (res) {
                    $('#totalDepartamentos').text(res.estadisticas.Total);
                    $('#totalActivos').text(res.estadisticas.Activos);
                    renderizarTabla(res.data);
                    $('#loadingIndicator').hide();
                    $('#tablaContent').show();
                }
            });
        }

        function renderizarTabla(data) {
            if (!data || data.length === 0) {
                $('#tablaContent').html('<div class="alert alert-info text-center">No se encontraron registros de departamentos.</div>');
                return;
            }

            let html = `
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Descripcion</th>
                                <th class="text-center">Cargos Activos</th>
                                <th class="text-center">Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            $.each(data, function (i, d) {
                let btnToggle = d.Activo
                    ? `<button class="btn btn-danger btn-sm" onclick="toggleDepartamento(${d.DepartamentoID}, '${d.Nombre}', true)"><i class="fas fa-trash"></i> Desactivar</button>`
                    : `<button class="btn btn-success btn-sm" onclick="toggleDepartamento(${d.DepartamentoID}, '${d.Nombre}', false)"><i class="fas fa-undo-alt"></i> Activar</button>`;

                html += `
                    <tr>
                        <td class="text-center">${d.DepartamentoID}</td>
                        <td><strong><i class="fas fa-building text-primary me-1"></i>${d.Nombre}</strong></td>
                        <td>${d.Descripcion}</td>
                        <td class="text-center"><span class="badge bg-info">${d.TotalCargos}</span></td>
                        <td class="text-center"><span class="badge ${d.Activo ? 'bg-success' : 'bg-danger'}">${d.Activo ? 'Activo' : 'Inactivo'}</span></td>
                        <td>
                            <a href="@Url.Action("Edit")/${d.DepartamentoID}" class="btn btn-warning btn-sm text-white"><i class="fas fa-edit"></i> Editar</a>
                            ${btnToggle}
                        </td>
                    </tr>
                `;
            });

            html += '</tbody></table></div>';
            $('#tablaContent').html(html);
        }

        function toggleDepartamento(id, nombre, activo) {
            Swal.fire({
                title: activo ? '¿Desactivar departamento?' : '¿Activar departamento?',
                text: `El departamento "${nombre}" cambiara de estado.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: activo ? '#d33' : '#28a745',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Confirmar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("ToggleActivo", "Departamentos")',
                        type: 'POST',
                        data: { id: id },
                        success: function (res) {
                            if (res.success) {
                                Swal.fire('Actualizado', res.message, 'success');
                                cargarDepartamentos();
                            }
                        }
                    });
                }
            });
        }
    </script>
}
