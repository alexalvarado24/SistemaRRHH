@model SistemaRRHH.Models.Horarios

@{
    ViewBag.Title = "Modificar Horario";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Formatear los TimeSpan nativos a formato "hh:mm" compatible con el input tipo time de HTML5
    string entradaFormateada = Model.HoraEntrada.ToString(@"hh\:mm");
    string salidaFormateada = Model.HoraSalida.ToString(@"hh\:mm");
}

<style>
    .card {
        border-radius: 15px;
        border: none;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }

    .form-label {
        font-weight: 600;
        color: #333;
    }

    .required:after {
        content: " *";
        color: #dc3545;
    }
</style>

<h2 class="mb-4"><i class="fas fa-edit text-warning"></i> Modificar Horario #@Model.HorarioID</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.HorarioID)
    @Html.HiddenFor(model => model.Activo)

    <div class="card">
        <div class="card-header bg-warning text-white">
            <h5 class="mb-0"><i class="fas fa-clock"></i> Configuracion de Turno</h5>
        </div>
        <div class="card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger mb-3">
                    <i class="fas fa-ex some-circle"></i> @TempData["Error"]
                </div>
            }

            <div class="mb-3">
                @Html.LabelFor(model => model.Nombre, "Nombre del Horario", new { @class = "form-label required" })
                @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", required = "required" })
                @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label required" for="HoraEntrada">Hora de Entrada</label>
                    <input type="time" id="HoraEntrada" name="HoraEntrada" class="form-control" value="@entradaFormateada" required />
                    @Html.ValidationMessageFor(model => model.HoraEntrada, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label required" for="HoraSalida">Hora de Salida</label>
                    <input type="time" id="HoraSalida" name="HoraSalida" class="form-control" value="@salidaFormateada" required />
                    @Html.ValidationMessageFor(model => model.HoraSalida, "", new { @class = "text-danger" })
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between">
                <a href="@Url.Action("Index")" class="btn btn-secondary px-4">
                    <i class="fas fa-arrow-left"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-warning px-4 text-white fw-bold">
                    <i class="fas fa-save"></i> Actualizar Horario
                </button>
            </div>
        </div>
    </div>
}