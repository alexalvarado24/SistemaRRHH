@model SistemaRRHH.Models.Horarios

@{
    ViewBag.Title = "Nuevo Horario";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .card {
        border-radius: 15px;
        border: none;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
    }

    .form-label {
        font-weight: 600;
        color: #333;
    }

    .required:after {
        content: " *";
        color: #dc3545;
    }
</style>

<h2 class="mb-4"><i class="fas fa-clock text-primary"></i> Registrar Nuevo Horario</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-info-circle"></i> Definicion de Turno</h5>
        </div>
        <div class="card-body">
            <div class="mb-3">
                @Html.LabelFor(model => model.Nombre, "Nombre del Horario / Turno", new { @class = "form-label required" })
                @Html.TextBoxFor(model => model.Nombre, new { @class = "form-control", placeholder = "Ej. Turno Matutino Ordinario", required = "required" })
                @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.HoraEntrada, "Hora de Entrada", new { @class = "form-label required" })
                    @Html.TextBoxFor(model => model.HoraEntrada, new { @class = "form-control", type = "time", required = "required" })
                    @Html.ValidationMessageFor(model => model.HoraEntrada, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.HoraSalida, "Hora de Salida", new { @class = "form-label required" })
                    @Html.TextBoxFor(model => model.HoraSalida, new { @class = "form-control", type = "time", required = "required" })
                    @Html.ValidationMessageFor(model => model.HoraSalida, "", new { @class = "text-danger" })
                </div>
            </div>

            <hr />

            <div class="d-flex justify-content-between">
                <a href="@Url.Action("Index")" class="btn btn-secondary px-4">
                    <i class="fas fa-arrow-left"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-save"></i> Guardar Horario
                </button>
            </div>
        </div>
    </div>
}