@{
    ViewBag.Title = "Horarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .display-4 {
        font-size: 2rem;
    }

    .table td {
        vertical-align: middle;
    }

    .card {
        border-radius: 15px;
        border: none;
        box-shadow: 0 0 20px rgba(0,0,0,0.1);
        transition: transform 0.3s;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .table-hover tbody tr:hover {
        background-color: rgba(0,123,255,0.1);
    }
</style>

<h2>Gestion de Horarios</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row mb-3">
    <div class="col-md-6">
        <p>
            <a href="@Url.Action("Create")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Crear Nuevo Horario
            </a>
            <button id="btnMostrarInactivos" class="btn btn-secondary">
                <i class="fas fa-eye"></i> Mostrar Inactivos
            </button>
        </p>
    </div>
    <div class="col-md-6">
        <div class="input-group">
            <input type="text" id="busquedaRapida" class="form-control" placeholder="Buscar por nombre de horario..." />
            <span class="input-group-text bg-primary text-white">
                <i class="fas fa-search"></i>
            </span>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-md-6">
        <div class="card text-white bg-primary">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-clock"></i> Total Horarios</h5>
                <p class="card-text display-4" id="totalHorarios">0</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card text-white bg-success">
            <div class="card-body">
                <h5 class="card-title"><i class="fas fa-toggle-on"></i> Horarios Activos</h5>
                <p class="card-text display-4" id="totalActivos">0</p>
            </div>
        </div>
    </div>
</div>

<div id="tablaContainer">
    <div class="text-center p-5" id="loadingIndicator">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Cargando horarios...</p>
    </div>
    <div id="tablaContent" style="display: none;"></div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        let filters = { busqueda: '', mostrarInactivos: false };

        $(document).ready(function() {
            cargarHorarios();

            $('#busquedaRapida').on('input', function() {
                filters.busqueda = $(this).val();
                cargarHorarios();
            });

            $('#btnMostrarInactivos').click(function() {
                filters.mostrarInactivos = !filters.mostrarInactivos;
                $(this).text(filters.mostrarInactivos ? 'Mostrar Activos' : 'Mostrar Inactivos');
                $(this).toggleClass('btn-secondary btn-warning');
                cargarHorarios();
            });
        });

        function cargarHorarios() {
            $('#loadingIndicator').show();
            $('#tablaContent').hide();

            $.ajax({
                url: '@Url.Action("GetAll", "Horarios")',
                type: 'GET',
                data: filters,
                dataType: 'json',
                success: function(res) {
                    $('#totalHorarios').text(res.estadisticas.Total);
                    $('#totalActivos').text(res.estadisticas.Activos);
                    renderizarTabla(res.data);
                    $('#loadingIndicator').hide();
                    $('#tablaContent').show();
                }
            });
        }

        function renderizarTabla(data) {
            if (!data || data.length === 0) {
                $('#tablaContent').html('<div class="alert alert-info text-center">No se encontraron registros de horarios.</div>');
                return;
            }

            let html = `
                <div class="table-responsive">
                    <table class="table table-striped table-bordered table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Descripcion del Horario</th>
                                <th>Hora Entrada</th>
                                <th>Hora Salida</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
            `;

            $.each(data, function(i, h) {
                let btnToggle = h.Activo
                    ? `<button class="btn btn-danger btn-sm" onclick="toggleHorario(${h.HorarioID}, '${h.Nombre}', true)"><i class="fas fa-trash"></i> Desactivar</button>`
                    : `<button class="btn btn-success btn-sm" onclick="toggleHorario(${h.HorarioID}, '${h.Nombre}', false)"><i class="fas fa-undo-alt"></i> Activar</button>`;

                html += `
                    <tr>
                        <td class="text-center">${h.HorarioID}</td>
                        <td><strong>${h.Nombre}</strong></td>
                        <td>${h.HoraEntrada}</td>
                        <td>${h.HoraSalida}</td>
                        <td class="text-center"><span class="badge ${h.Activo ? 'bg-success' : 'bg-danger'}">${h.Activo ? 'Activo' : 'Inactivo'}</span></td>
                        <td>
                            <a href="@Url.Action("Edit")/${h.HorarioID}" class="btn btn-warning btn-sm"><i class="fas fa-edit"></i> Editar</a>
                            ${btnToggle}
                        </td>
                    </tr>
                `;
            });

            html += '</tbody></table></div>';
            $('#tablaContent').html(html);
        }

        function toggleHorario(id, nombre, activo) {
            Swal.fire({
                title: activo ? '¿Desactivar horario?' : '¿Activar horario?',
                text: `El horario "${nombre}" cambiara de estado operativo.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: activo ? '#d33' : '#28a745',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Confirmar'
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        url: '@Url.Action("ToggleActivo", "Horarios")',
                        type: 'POST',
                        data: { id: id },
                        success: function(res) {
                            if (res.success) {
                                Swal.fire('Actualizado', res.message, 'success');
                                cargarHorarios();
                            }
                        }
                    });
                }
            });
        }
    </script>
}