@model SistemaRRHH.Models.Cargos

@{
    ViewBag.Title = "Modificar Cargo";
}

<h2 class="mb-4"><i class="fas fa-edit text-warning"></i> Modificar Cargo #@Model.CargoID</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.CargoID)
    @Html.HiddenFor(model => model.Activo)

    <div class="card shadow-sm">
        <div class="card-header bg-warning text-white">
            <h5 class="mb-0"><i class="fas fa-briefcase"></i> Detalles del Puesto</h5>
        </div>
        <div class="card-body">

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">
                    <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
                </div>
            }

            <div class="row">
                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.NombreCargo, "Nombre de la Plaza / Puesto *", new { @class = "form-label fw-bold" })
                    @Html.TextBoxFor(model => model.NombreCargo, new { @class = "form-control", required = "required" })
                    @Html.ValidationMessageFor(model => model.NombreCargo, "", new { @class = "text-danger" })
                </div>

                <div class="col-md-6 mb-3">
                    @Html.LabelFor(model => model.DepartamentoID, "Departamento Asignado *", new { @class = "form-label fw-bold" })
                    @Html.DropDownList("DepartamentoID", null, new { @class = "form-select", required = "required" })
                    @Html.ValidationMessageFor(model => model.DepartamentoID, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="mb-3">
                @Html.LabelFor(model => model.Descripcion, "Descripción de Funciones", new { @class = "form-label fw-bold" })
                @Html.TextAreaFor(model => model.Descripcion, new { @class = "form-control", rows = "3" })
                @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
            </div>

            <hr />

            <div class="d-flex justify-content-between">
                <a href="@Url.Action("Index")" class="btn btn-secondary px-4">
                    <i class="fas fa-arrow-left"></i> Cancelar
                </a>
                <button type="submit" class="btn btn-warning px-4 text-white fw-bold">
                    <i class="fas fa-save"></i> Actualizar Cargo
                </button>
            </div>
        </div>
    </div>
}