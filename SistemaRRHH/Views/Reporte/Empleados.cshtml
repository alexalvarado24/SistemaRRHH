@{
	ViewBag.Title = "Reporte de Empleados";
	Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
	.card {
		border-radius: 15px;
		border: none;
		box-shadow: 0 0 20px rgba(0,0,0,0.1);
	}

	.btn-report, .btn-download {
		background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
		border: none;
		padding: 12px 30px;
		margin: 10px;
		border-radius: 8px;
		color: white;
		cursor: pointer;
		text-decoration: none;
		display: inline-block;
		font-size: 16px;
		font-weight: bold;
	}

	.btn-download {
		background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
	}

		.btn-report:hover, .btn-download:hover {
			opacity: 0.9;
			transform: translateY(-2px);
			transition: all 0.3s;
			box-shadow: 0 5px 15px rgba(0,0,0,0.2);
		}

	iframe {
		border-radius: 10px;
		border: 1px solid #ddd;
		width: 100%;
		height: 600px;
	}

	.info-box {
		background-color: #e9ecef;
		padding: 15px;
		border-radius: 10px;
		margin-top: 20px;
		text-align: center;
	}
</style>

<div class="card">
	<div class="card-header bg-success text-white">
		<h5 class="mb-0">
			<i class="fas fa-chart-line"></i> Reporte de Empleados
		</h5>
	</div>
	<div class="card-body">
		<div class="text-center">
			<button id="btnVerReporte" class="btn-report">
				<i class="fas fa-eye"></i> Ver Reporte
			</button>

			<a href="@Url.Action("DescargarEmpleados", "Reporte")" id="btnDescargar" class="btn-download">
				<i class="fas fa-download"></i> Descargar PDF
			</a>
		</div>
		<hr />
		<iframe id="reporteSimple" frameborder="0" scrolling="yes" style="display:none;"></iframe>
		<div id="sinReporte" class="info-box">
			<i class="fas fa-chart-line fa-3x text-success"></i>
			<p class="mt-2">Haga clic en <strong>"Ver Reporte"</strong> para visualizar el reporte de empleados</p>
			<small class="text-muted">El reporte se abrira en el visor PDF integrado</small>
		</div>
	</div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    $(document).ready(function () {
        var reporteUrl = "@Url.Action("VerEmpleados", "Reporte")";

        // Boton Ver Reporte
        $("#btnVerReporte").on("click", function () {
            $("#sinReporte").hide();
            $("#reporteSimple").show();
            $("#reporteSimple").attr("src", reporteUrl);
        });
    });
</script>

@section Scripts {
	<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/js/all.min.js"></script>
}